# ─────────────────────────────────────────────────────────────────────────────
# ProjectPilot Environment Configuration Template
# Copy to .env for local Docker Compose or production deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node / Server Environment ──
NODE_ENV=production
LOG_LEVEL=info
LOG_REDACT=true

# ── Ports ──
# API listening port (Docker Compose exposes this port, maps to container 4000)
API_PORT=4000
PORT=4000
WEB_PORT=80
POSTGRES_PORT=5432

# ── PostgreSQL Database ──
POSTGRES_USER=projectpilot
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=projectpilot
# Used by the API service (in Docker Compose, 'postgres' service name resolves automatically):
DATABASE_URL=postgres://projectpilot:replace_with_a_secure_database_password@postgres:5432/projectpilot

# ── Session & Authentication Security ──
# Cryptographically random key (at least 32 characters). Both JWT_SECRET and SESSION_SECRET are supported aliases.
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_chars_long
SESSION_SECRET=replace_with_a_secure_jwt_secret_at_least_32_chars_long
SESSION_COOKIE_NAME=pp_session

# ── CORS Allowed Origins ──
# Comma-separated list of origins allowed to access the API with session credentials
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:4000,http://localhost:5173

# ── Nebius Token Factory & NVIDIA Nemotron AI Configuration ──
# Vouchlock uses NVIDIA Nemotron served through Nebius Token Factory for project delivery analysis,
# candidate requirement extraction, task planning, and evidence gap detection.
# Nebius Token Factory is the sole production runtime. Legacy Gemini/OpenAI providers are removed.
AI_PROVIDER=nebius

# Required for server-side AI requests: Nebius Token Factory API key.
# Server-side only: keys are never sent to the browser, stored in client storage, or logged.
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here

# Official target NVIDIA open-source model ID on Nebius Token Factory:
NEBIUS_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct

# Official Nebius Token Factory API base URL (OpenAI-compatible wire protocol):
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# ── BYOK Server-Side Encryption (AES-256-GCM) ──
# 32-byte hex or base64 secret used to encrypt user BYOK provider keys in server memory.
# If omitted, derived deterministically from JWT_SECRET using HMAC-SHA256.
ENCRYPTION_SECRET=replace_with_a_secure_32_byte_hex_encryption_secret
