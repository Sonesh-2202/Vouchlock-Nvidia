{
  "name": "@projectpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/auth.test.ts tests/config.test.ts tests/planner.test.ts tests/requirements.test.ts tests/byok-registry.test.ts tests/copilot.test.ts tests/mcp.test.ts tests/ssrf.test.ts",
    "test:integration": "vitest run tests/permissions-security.test.ts tests/workflow-integration.test.ts tests/ai-groundedness.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@projectpilot/contracts": "workspace:*",
    "@projectpilot/domain": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.35.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.0",
    "nanoid": "^5.0.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "0.26.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
